@model List<BibliotecaMVC.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@ViewData["Title"] <small class="text-muted">(@Model.Count())</small></h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo Autor +</a>
</div>

<div class="row">
    @foreach (var autor in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card mb-4 shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title">@autor.Nombre @autor.Apellido</h5>
                        <p class="card-text">
                            <strong>Nacionalidad:</strong> @autor.Nacionalidad<br />
                            <strong>Fecha de Nacimiento:</strong> @autor.FechaNacimiento.ToString("dd/MM/yyyy")
                        </p>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-1 align-items-center">
                        <a asp-action="Editar" asp-route-id="@autor.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@autor.Id" class="btn btn-info btn-sm">Detalles</a>

                        <form asp-action="Eliminar" asp-route-id="@autor.Id" method="post" class="swal-delete-form d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>