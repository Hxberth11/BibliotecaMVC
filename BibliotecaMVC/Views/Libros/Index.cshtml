@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2>Listado de Libros</h2>
    <a asp-action="Create" class="btn btn-success">Agregar Nuevo Libro</a>
</div>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <!-- Imagen desde wwwroot/images/ -->
                <img src="~/images/@libro.ImagenUrl" class="card-img-top" alt="@libro.Titulo" style="height: 250px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <p class="card-text text-muted mb-1"><strong>Autor:</strong> @libro.Autor</p>
                    <p class="card-text text-muted mb-1"><strong>Género:</strong> @libro.Genero</p>
                    <p class="card-text text-muted"><strong>Año:</strong> @libro.AnioPublicacion</p>
                    
                    <div class="mt-auto d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-info btn-sm text-white">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-danger btn-sm" onclick="return confirm('¿Deseas eliminar este libro?');">Eliminar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
