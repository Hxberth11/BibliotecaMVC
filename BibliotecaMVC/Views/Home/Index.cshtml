@{
    ViewData["Title"] = "Inicio - Biblioteca Virtual";
}

<!-- Carga de Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4 mb-5 pb-5">
    <!-- Hero / Banner de Bienvenida -->
    <div class="p-5 bg-primary text-white rounded-3 shadow text-center mb-5">
        <h1 class="display-5 fw-bold"><i class="bi bi-book-half me-2"></i>Biblioteca Virtual MVC</h1>
        <p class="fs-5 mt-3">Tu portal digital de acceso a colecciones literarias, gestión de autores y servicios de préstamos en línea.</p>
        <a href="/Libros" class="btn btn-light text-primary fw-bold btn-lg mt-2 shadow-sm">Explorar Catálogo de Libros</a>
    </div>

    <!-- Módulos de Gestión (Tarjetas Principales) -->
    <div class="row g-4 mb-5">
        <!-- Tarjeta Libros -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-journal-text fs-1 text-primary"></i>
                    </div>
                    <h3 class="card-title text-primary h4">Catálogo de Libros</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Explora los títulos disponibles, consulta disponibilidad y gestiona el inventario de la biblioteca.
                    </p>
                    <a href="/Libros" class="btn btn-primary mt-3">Ver Libros</a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Autores -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-person-lines-fill fs-1 text-primary"></i>
                    </div>
                    <h3 class="card-title text-primary h4">Directorio de Autores</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Conoce las biografías y las colecciones bibliográficas de los autores registrados.
                    </p>
                    <a href="/Autores" class="btn btn-primary mt-3">Ver Autores</a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Categorías -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-tags-fill fs-1 text-primary"></i>
                    </div>
                    <h3 class="card-title text-primary h4">Categorías y Géneros</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Navega por la literatura clasificada según géneros, áreas de estudio y temas.
                    </p>
                    <a href="/Home/Categorias" class="btn btn-primary mt-3">Ver Categorías</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección Complementaria: Servicios Bibliotecarios -->
    <div class="bg-light p-4 rounded-3 border mb-5">
        <h2 class="h4 text-center text-primary mb-4 fw-bold">Servicios Bibliotecarios Disponibles</h2>
        <div class="row text-center g-3">
            <div class="col-md-4">
                <i class="bi bi-arrow-repeat fs-3 text-primary"></i>
                <h4 class="h6 mt-2 fw-bold">Préstamos en Línea</h4>
                <p class="small text-muted mb-0">Solicitud y reserva de libros directamente desde la plataforma.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-search fs-3 text-primary"></i>
                <h4 class="h6 mt-2 fw-bold">Búsqueda Avanzada</h4>
                <p class="small text-muted mb-0">Filtros por ISBN, título, autor o categoría literaria.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-laptop fs-3 text-primary"></i>
                <h4 class="h6 mt-2 fw-bold">Acceso Digital 24/7</h4>
                <p class="small text-muted mb-0">Consulta del catálogo de la biblioteca desde cualquier dispositivo.</p>
            </div>
        </div>
    </div>

    <!-- ACTIVIDAD 5 (RETO): Componente Bootstrap adicional - Acordeón de Preguntas Frecuentes -->
    <div class="my-5">
        <h2 class="h4 text-center text-primary mb-4 fw-bold">Preguntas Frecuentes</h2>
        <div class="accordion shadow-sm" id="accordionFAQ">
            
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        <i class="bi bi-question-circle text-primary me-2"></i> ¿Cómo solicito el préstamo de un libro?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFAQ">
                    <div class="accordion-body text-secondary">
                        Puedes explorar el catálogo en la sección de <strong>Libros</strong>, seleccionar el título de tu interés y presionar el botón de solicitud para reservar tu ejemplar.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        <i class="bi bi-clock-history text-primary me-2"></i> ¿Cuál es el tiempo máximo de préstamo?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionFAQ">
                    <div class="accordion-body text-secondary">
                        El tiempo estándar de préstamo es de <strong>7 días calendario</strong>, con posibilidad de renovar por un período adicional desde tu perfil de usuario.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        <i class="bi bi-person-check text-primary me-2"></i> ¿Necesito estar registrado para consultar el catálogo?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionFAQ">
                    <div class="accordion-body text-secondary">
                        No, la búsqueda y consulta de libros y autores es de <strong>acceso libre</strong>. Solo necesitarás iniciar sesión al momento de realizar la reserva física del material.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>