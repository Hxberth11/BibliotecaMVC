@model IEnumerable<BibliotecaMVC.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<h2 class="mt-4 mb-4">Listado de Categorías</h2>

<a class="btn btn-primary mb-3" asp-controller="Categorias" asp-action="Create">Agregar categoría</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-primary btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        var mensaje = '@(TempData["SuccessMessage"] ?? "")';
        if(mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                confirmButtonText: 'Aceptar'
            });
        }
    </script>
}